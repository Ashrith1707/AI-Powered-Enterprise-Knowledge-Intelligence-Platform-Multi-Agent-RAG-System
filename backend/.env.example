# ============================================================
# KnowledgeIQ backend configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Application ---
APP_ENV=development            # development | production
DEBUG=false

# --- Database ---
# Development (SQLite):
DATABASE_URL=sqlite:///./data/knowledgeiq.db
# Production (PostgreSQL) — SQLite is rejected when APP_ENV=production:
# DATABASE_URL=postgresql+psycopg2://knowledgeiq:knowledgeiq@localhost:5432/knowledgeiq

# --- Security (REQUIRED in production) ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Uploads ---
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,md,png,jpg,jpeg,tiff

# --- Google Gemini (modern google-genai SDK) ---
# IMPORTANT: text-embedding-004 is DEPRECATED (404 on v1beta).
# Use gemini-embedding-001 with the google-genai SDK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Provider overrides: auto | gemini | local / auto | gemini | mock
# "auto" uses Gemini when a key is present and falls back to a clearly
# reported offline mode otherwise (never silently).
EMBEDDING_PROVIDER=auto
LLM_PROVIDER=auto

# --- OCR (optional) ---
# TESSERACT_CMD=/usr/bin/tesseract

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=8
RERANK_TOP_N=5
MAX_EVIDENCE_CHARS=6000
# Absolute relevance floor for evidence (reranker v2 absolute scores)
MIN_RELEVANCE_SCORE=0.30

# --- Agents ---
VERIFICATION_USE_LLM=false
RERANKER_USE_LLM=false
MAX_REGENERATION_ATTEMPTS=1
