# ============================================================
# KnowledgeIQ — Docker Compose environment template
# Copy to .env and set real values. NEVER commit .env.
# ============================================================

# --- PostgreSQL (compose service `db`) ---
POSTGRES_USER=knowledgeiq
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=knowledgeiq

# --- Backend security (REQUIRED) ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Google Gemini (modern google-genai SDK) ---
# gemini-embedding-001 replaces the deprecated text-embedding-004.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Frontend / CORS ---
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080

# --- Uploads ---
MAX_UPLOAD_MB=25
